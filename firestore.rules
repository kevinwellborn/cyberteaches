rules_version = '2';
// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function teacherOf(code) {
      return get(/databases/$(database)/documents/classes/$(code)).data.teacherUid == request.auth.uid;
    }
    // Kevin approves teachers. Only approved teachers can create classes or read the answer key.
    function isAdmin() { return signedIn() && request.auth.token.email == "kevinwellborn714@gmail.com"; }
    function approvedTeacher() {
      return isAdmin() || (exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.status == 'approved');
    }

    // Teacher access requests. A signed-in person asks once (status pending); the admin approves or rejects.
    match /teachers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'school', 'status', 'requestedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.school is string && request.resource.data.school.size() <= 80;
      allow update, delete: if isAdmin();
    }
    // Site settings for approved teachers (the secret that unlocks the answer key). Only the admin writes them.
    match /config/{doc} {
      allow read: if approvedTeacher();
      allow write: if isAdmin();
    }

    // A student's own progress. Only that student can read or change it.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      // Kevin's account can also read every student's progress.
      allow read: if signedIn() && request.auth.token.email == "kevinwellborn714@gmail.com";
    }

    // Classes are created by teachers. Any signed-in student can look one up by its code to join.
    match /classes/{code} {
      allow read: if signedIn();
      allow create: if approvedTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && code.matches('^[A-Z0-9]{6}$');
      allow update, delete: if signedIn() && resource.data.teacherUid == request.auth.uid;

      // Roster copy of each student's stars. The student writes it; the class's teacher reads it.
      match /students/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || teacherOf(code));
        allow create, update: if signedIn() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/classes/$(code));
        allow delete: if signedIn() && (request.auth.uid == uid || teacherOf(code));
      }

      // Leaderboard: a short name, total stars and puzzles solved. Students in the class (and its teacher) can read it;
      // each student writes only their own row.
      match /board/{uid} {
        allow read: if signedIn() && (teacherOf(code)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('classCode', '') == code);
        allow create, update: if signedIn() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/classes/$(code))
          && request.resource.data.keys().hasOnly(['name', 'stars', 'solved', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars <= 3000
          && request.resource.data.solved is int && request.resource.data.solved >= 0 && request.resource.data.solved <= 1000;
        allow delete: if signedIn() && (request.auth.uid == uid || teacherOf(code));
      }

      // ---- Duels (academy/duel.js): two classmates, same puzzle, 4 minutes, fewest blocks wins 1 trophy. ----
      // The teacher turns them on with classes/{code}.duels == true.
      function classMember() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('classCode', '') == code;
      }
      function duelsOn() {
        return get(/databases/$(database)/documents/classes/$(code)).data.get('duels', false) == true;
      }
      match /duels/{id} {
        function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
        // A map field where only my own key changed (or nothing did).
        function onlyMine(f) {
          return request.resource.data[f].diff(resource.data[f]).affectedKeys().hasOnly([request.auth.uid]);
        }
        function same(f) { return request.resource.data[f] == resource.data[f]; }
        function mineNow(f) { return request.resource.data[f].get(request.auth.uid, null); }
        function mineBefore(f) { return resource.data[f].get(request.auth.uid, null); }
        function inTime() { return request.time < resource.data.startedAt + duration.value(255, 's'); }
        function goodName(m) { return m[request.auth.uid] is string && m[request.auth.uid].size() <= 40; }
        function goodResult(v) {
          return v is map && v.keys().hasOnly(['blocks', 'ms']) && v.blocks is int && v.blocks >= 1 && v.blocks <= 200
            && v.ms is int && v.ms >= 0 && v.ms <= 260000;
        }
        allow read: if signedIn() && (classMember() || teacherOf(code));
        // Start waiting for an opponent.
        allow create: if signedIn() && classMember() && duelsOn()
          && request.resource.data.keys().hasOnly(['level', 'seed', 'state', 'players', 'names', 'createdAt', 'r', 'done', 'stake', 'settled'])
          && request.resource.data.state == 'waiting'
          && request.resource.data.players == [request.auth.uid]
          && request.resource.data.level in ['easy', 'medium', 'hard']
          && request.resource.data.seed is int
          && request.resource.data.createdAt == request.time
          && request.resource.data.names.keys().hasOnly([request.auth.uid]) && goodName(request.resource.data.names)
          && request.resource.data.r == {} && request.resource.data.done == {}
          && request.resource.data.stake == {} && request.resource.data.settled == {};
        // The waiting player keeps the duel fresh.
        allow update: if signedIn() && resource.data.state == 'waiting' && resource.data.players[0] == request.auth.uid
          && changed().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
        // A classmate joins: the duel starts now and the joiner stakes 1 trophy (with the duelBoard write in the same transaction).
        allow update: if signedIn() && classMember() && duelsOn()
          && resource.data.state == 'waiting' && resource.data.players.size() == 1
          && resource.data.players[0] != request.auth.uid
          && changed().hasOnly(['players', 'state', 'startedAt', 'names', 'stake'])
          && request.resource.data.players == resource.data.players.concat([request.auth.uid])
          && request.resource.data.state == 'playing' && request.resource.data.startedAt == request.time
          && onlyMine('names') && goodName(request.resource.data.names)
          && onlyMine('stake') && mineNow('stake') == true;
        // Playing: each player changes only their own result, done flag, stake and settled flag.
        allow update: if signedIn() && resource.data.state == 'playing' && request.auth.uid in resource.data.players
          && changed().hasOnly(['r', 'done', 'stake', 'settled'])
          && onlyMine('r') && onlyMine('done') && onlyMine('stake') && onlyMine('settled')
          && (same('r') || (inTime() && mineBefore('done') == null && goodResult(mineNow('r'))))
          && (same('done') || mineNow('done') == true)
          && (same('stake') || (mineNow('stake') == true && mineBefore('stake') == null && inTime()))
          && (same('settled') || (mineNow('settled') == true && mineBefore('settled') == null && mineBefore('stake') == true));
        allow delete: if signedIn() && (teacherOf(code)
          || (resource.data.state == 'waiting' && (resource.data.players[0] == request.auth.uid
                || (classMember() && request.time > resource.data.createdAt + duration.value(100, 's'))))
          || (resource.data.state == 'playing' && request.auth.uid in resource.data.players
                && resource.data.settled.size() == resource.data.players.size()));
      }

      // Duel trophies. Shown trophies = 3 + 1 per 10 lesson stars (board/{uid}.stars) + net + free.
      // Each change is tied to one step of one duel, so a trophy can only move when a duel really happened.
      match /duelBoard/{uid} {
        function duelPath() { return /databases/$(database)/documents/classes/$(code)/duels/$(request.resource.data.lastDuel); }
        function boardStars() {
          return exists(/databases/$(database)/documents/classes/$(code)/board/$(uid))
            ? get(/databases/$(database)/documents/classes/$(code)/board/$(uid)).data.stars : 0;
        }
        function trophies(d) { return 3 + math.floor(boardStars() / 10) + d.net + d.free; }
        function n() { return request.resource.data; }
        function o() { return resource.data; }
        function keysOk() {
          return n().keys().hasOnly(['name', 'net', 'free', 'played', 'wins', 'losses', 'ties', 'lastDuel', 'lastFree', 'updatedAt'])
            && n().name is string && n().name.size() <= 40 && n().updatedAt == request.time
            && n().net is int && n().free is int && n().played is int && n().wins is int && n().losses is int && n().ties is int
            && n().lastDuel is string;
        }
        function recordSame() {
          return n().played == o().played && n().wins == o().wins && n().losses == o().losses && n().ties == o().ties;
        }
        // Put in 1 trophy for a duel that just started (needs at least 1 trophy).
        function stakeStep() {
          return n().net == o().net - 1 && n().free == o().free && recordSame() && trophies(o()) >= 1
            && getAfter(duelPath()).data.stake.get(uid, false) == true
            && get(duelPath()).data.stake.get(uid, false) != true;
        }
        // After the duel: win +2 (both stakes), tie +1 (stake back), loss +0.
        function settleStep() {
          return n().free == o().free && n().played == o().played + 1
            && n().wins >= o().wins && n().losses >= o().losses && n().ties >= o().ties
            && n().wins + n().losses + n().ties == o().wins + o().losses + o().ties + 1
            && n().net - o().net == (n().wins - o().wins) * 2 + (n().ties - o().ties)
            && getAfter(duelPath()).data.settled.get(uid, false) == true
            && get(duelPath()).data.settled.get(uid, false) != true;
        }
        // Out of trophies: 1 free trophy, at most once every 20 hours.
        function freeStep() {
          return n().free == o().free + 1 && n().net == o().net && recordSame() && n().lastDuel == o().lastDuel
            && trophies(o()) <= 0 && n().lastFree == request.time
            && (!('lastFree' in o()) || request.time > o().lastFree + duration.value(20, 'h'));
        }
        allow read: if signedIn() && (teacherOf(code) || classMember());
        allow create: if signedIn() && request.auth.uid == uid && classMember() && keysOk()
          && n().net == 0 && n().free == 0 && n().played == 0 && n().wins == 0 && n().losses == 0 && n().ties == 0
          && n().lastDuel == '' && !('lastFree' in n());
        allow update: if signedIn() && request.auth.uid == uid && keysOk()
          && (!('lastFree' in o()) || n().get('lastFree', null) == o().lastFree || freeStep())
          && (stakeStep() || settleStep() || freeStep());
        // The teacher can reset the Duel scoreboard.
        allow delete: if signedIn() && teacherOf(code);
      }

      // Student logins the teacher made (name, username, password). Only the class's teacher can see or change them.
      match /logins/{uid} {
        allow read, write: if signedIn() && teacherOf(code);
      }
    }

    // Live quiz battles. Anyone signed in can host (hostUid is their own uid) or join with the 6-digit PIN.
    match /quizzes/{pin} {
      function quiz() { return get(/databases/$(database)/documents/quizzes/$(pin)).data; }
      function isHost() { return quiz().hostUid == request.auth.uid; }
      allow read: if signedIn();
      allow create: if signedIn() && pin.matches('^[0-9]{6}$')
        && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid;

      // Players join themselves with a score of 0. Only the host changes scores or removes players.
      match /players/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid && quiz().state != 'end'
          && request.resource.data.keys().hasOnly(['name', 'score', 'joinedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.score == 0;
        allow update: if signedIn() && isHost();
        allow delete: if signedIn() && (isHost() || request.auth.uid == uid);
      }

      // One answer per player per question, only while that question is open. The host reads and scores them.
      match /answers/{id} {
        allow read: if signedIn() && (isHost() || resource.data.uid == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'q', 'choice', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.q is int && request.resource.data.choice is int
          && request.resource.data.choice >= 0 && request.resource.data.choice <= 3
          && id == string(request.resource.data.q) + '_' + request.auth.uid
          && request.resource.data.at == request.time
          && quiz().state == 'question' && quiz().q == request.resource.data.q
          && request.time < quiz().startedAt + duration.value(quiz().time + 3, 's')
          && exists(/databases/$(database)/documents/quizzes/$(pin)/players/$(request.auth.uid));
        allow delete: if signedIn() && isHost();
      }
    }

    // ---- Congressional Award Tracker (cyberteaches.com/award-tracker) ----
    // A student's record: only the student can change it. The student and the Advisors they listed
    // (signed in with that email, and the email verified) can read it. Nobody else can, including the admin.
    function verifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true && request.auth.token.email is string;
    }
    function advisorOf(data) {
      return verifiedEmail() && data.get('advisorEmails', []).hasAny([request.auth.token.email.lower()]);
    }
    match /awardTrackers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || advisorOf(resource.data));
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['profile', 'advisorEmails', 'ownerEmail', 'updatedAt'])
        && request.resource.data.profile is map && request.resource.data.profile.size() <= 10
        && request.resource.data.advisorEmails is list && request.resource.data.advisorEmails.size() <= 10;
      allow delete: if signedIn() && request.auth.uid == uid;

      match /entries/{id} {
        allow read: if signedIn() && (request.auth.uid == uid
          || advisorOf(get(/databases/$(database)/documents/awardTrackers/$(uid)).data));
        allow create, update: if signedIn() && request.auth.uid == uid
          && id.size() <= 64 && request.resource.data.size() <= 16;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }
    // Lets an Advisor find the students who shared with them. Each student writes only their own row.
    match /advisorLinks/{email}/students/{uid} {
      allow read: if verifiedEmail() && request.auth.token.email.lower() == email;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['studentName', 'addedAt'])
        && request.resource.data.studentName is string && request.resource.data.studentName.size() <= 80;
      allow delete: if signedIn() && (request.auth.uid == uid
        || (verifiedEmail() && request.auth.token.email.lower() == email));
    }
  }
}
