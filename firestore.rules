rules_version = '2';
// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function teacherOf(code) {
      return get(/databases/$(database)/documents/classes/$(code)).data.teacherUid == request.auth.uid;
    }
    // Kevin approves teachers. Only approved teachers can create classes or read the answer key.
    function isAdmin() { return signedIn() && request.auth.token.email == "kevinwellborn714@gmail.com"; }
    function approvedTeacher() {
      return isAdmin() || (exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.status == 'approved');
    }

    // Teacher access requests. A signed-in person asks once (status pending); the admin approves or rejects.
    match /teachers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'school', 'status', 'requestedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.school is string && request.resource.data.school.size() <= 80;
      allow update, delete: if isAdmin();
    }
    // Site settings for approved teachers (the secret that unlocks the answer key). Only the admin writes them.
    match /config/{doc} {
      allow read: if approvedTeacher();
      allow write: if isAdmin();
    }

    // A student's own progress. Only that student can read or change it.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      // Kevin's account can also read every student's progress.
      allow read: if signedIn() && request.auth.token.email == "kevinwellborn714@gmail.com";
    }

    // Classes are created by teachers. Any signed-in student can look one up by its code to join.
    match /classes/{code} {
      allow read: if signedIn();
      allow create: if approvedTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && code.matches('^[A-Z0-9]{6}$');
      allow update, delete: if signedIn() && resource.data.teacherUid == request.auth.uid;

      // Roster copy of each student's stars. The student writes it; the class's teacher reads it.
      match /students/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || teacherOf(code));
        allow create, update: if signedIn() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/classes/$(code));
        allow delete: if signedIn() && (request.auth.uid == uid || teacherOf(code));
      }

      // Leaderboard: a short name, total stars and puzzles solved. Students in the class (and its teacher) can read it;
      // each student writes only their own row.
      match /board/{uid} {
        allow read: if signedIn() && (teacherOf(code)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('classCode', '') == code);
        allow create, update: if signedIn() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/classes/$(code))
          && request.resource.data.keys().hasOnly(['name', 'stars', 'solved', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars <= 3000
          && request.resource.data.solved is int && request.resource.data.solved >= 0 && request.resource.data.solved <= 1000;
        allow delete: if signedIn() && (request.auth.uid == uid || teacherOf(code));
      }

      // Student logins the teacher made (name, username, password). Only the class's teacher can see or change them.
      match /logins/{uid} {
        allow read, write: if signedIn() && teacherOf(code);
      }
    }

    // Live quiz battles. Anyone signed in can host (hostUid is their own uid) or join with the 6-digit PIN.
    match /quizzes/{pin} {
      function quiz() { return get(/databases/$(database)/documents/quizzes/$(pin)).data; }
      function isHost() { return quiz().hostUid == request.auth.uid; }
      allow read: if signedIn();
      allow create: if signedIn() && pin.matches('^[0-9]{6}$')
        && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid;

      // Players join themselves with a score of 0. Only the host changes scores or removes players.
      match /players/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid && quiz().state != 'end'
          && request.resource.data.keys().hasOnly(['name', 'score', 'joinedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.score == 0;
        allow update: if signedIn() && isHost();
        allow delete: if signedIn() && (isHost() || request.auth.uid == uid);
      }

      // One answer per player per question, only while that question is open. The host reads and scores them.
      match /answers/{id} {
        allow read: if signedIn() && (isHost() || resource.data.uid == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'q', 'choice', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.q is int && request.resource.data.choice is int
          && request.resource.data.choice >= 0 && request.resource.data.choice <= 3
          && id == string(request.resource.data.q) + '_' + request.auth.uid
          && request.resource.data.at == request.time
          && quiz().state == 'question' && quiz().q == request.resource.data.q
          && request.time < quiz().startedAt + duration.value(quiz().time + 3, 's')
          && exists(/databases/$(database)/documents/quizzes/$(pin)/players/$(request.auth.uid));
        allow delete: if signedIn() && isHost();
      }
    }

    // ---- Congressional Award Tracker (cyberteaches.com/award-tracker) ----
    // A student's record: only the student can change it. The student and the Advisors they listed
    // (signed in with that email, and the email verified) can read it. Nobody else can, including the admin.
    function verifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true && request.auth.token.email is string;
    }
    function advisorOf(data) {
      return verifiedEmail() && data.get('advisorEmails', []).hasAny([request.auth.token.email.lower()]);
    }
    match /awardTrackers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || advisorOf(resource.data));
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['profile', 'advisorEmails', 'ownerEmail', 'updatedAt'])
        && request.resource.data.profile is map && request.resource.data.profile.size() <= 10
        && request.resource.data.advisorEmails is list && request.resource.data.advisorEmails.size() <= 10;
      allow delete: if signedIn() && request.auth.uid == uid;

      match /entries/{id} {
        allow read: if signedIn() && (request.auth.uid == uid
          || advisorOf(get(/databases/$(database)/documents/awardTrackers/$(uid)).data));
        allow create, update: if signedIn() && request.auth.uid == uid
          && id.size() <= 64 && request.resource.data.size() <= 16;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }
    // Lets an Advisor find the students who shared with them. Each student writes only their own row.
    match /advisorLinks/{email}/students/{uid} {
      allow read: if verifiedEmail() && request.auth.token.email.lower() == email;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['studentName', 'addedAt'])
        && request.resource.data.studentName is string && request.resource.data.studentName.size() <= 80;
      allow delete: if signedIn() && (request.auth.uid == uid
        || (verifiedEmail() && request.auth.token.email.lower() == email));
    }
  }
}
